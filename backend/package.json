{
  "name": "elastiflix-backend",
  "version": "0.2.0",
  "description": "Backend API for Elastiflix demo using Express and @elastic/search-ui-elasticsearch-connector.",
  "main": "src/Backend.js",
  "type": "module",
  "scripts": {
    "start": "node src/Backend.js",
    "dev": "nodemon src/Backend.js",
    "test": "node --experimental-test-module-mocks --test",
    "test:coverage": "c8 --reporter=lcov --report-dir=coverage node --experimental-test-module-mocks --test",
    "audit:policy": "node ../scripts/npm-audit-policy.js"
  },
  "dependencies": {
    "@elastic/search-ui-elasticsearch-connector": "^1.8.0",
    "amqplib": "^2.2.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "elasticsearch",
    "express",
    "search-ui",
    "demo"
  ],
  "author": "Shubham Londhe",
  "license": "MIT"
}
