FROM node:26-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --legacy-peer-deps
COPY . .
# Explicit prod API path (relative, proxied by nginx to backend:17700).
# Without this the build bakes `undefined` and relies on runtime fallback.
ENV REACT_APP_ES_API=/api
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# Switch to root to apply security updates
USER root
RUN apk update && apk upgrade --no-cache

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build /usr/share/nginx/html

# Switch back to the non-root nginx user for security
USER nginx

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
