aws_region   = "us-east-2"
cluster_name = "elastiflix-production"
environment  = "production"

# Replace these examples with three AZ names confirmed in the target AWS account.
availability_zone_names = ["REPLACE_WITH_AZ_1", "REPLACE_WITH_AZ_2", "REPLACE_WITH_AZ_3"]

# Keep the EKS API private; reach it from an approved administrative path.
cluster_endpoint_public_access_cidrs = []

# Required: set cluster_version only after checking EKS support, the pinned
# EKS module version, and the selected managed add-on versions.
